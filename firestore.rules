rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isResourceOwner() {
      return request.auth != null && (
        (resource == null && request.resource.data.ownerId == request.auth.uid) || 
        (resource != null && resource.data.ownerId == request.auth.uid)
      );
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update, delete: if isOwner(userId);
    }

    match /studios/{userId} {
      allow read: if true; 
      allow write: if isOwner(userId);
    }

    match /bookings/{bookingId} {
      // Public portal needs to read/update its own booking
      allow read: if true; 
      allow update: if true; 
      allow create, delete: if isResourceOwner();
    }
    
    match /clients/{clientId} {
      allow read, write: if isResourceOwner();
    }
    
    match /assets/{assetId} {
      allow read, write: if isResourceOwner();
    }
    
    match /accounts/{accountId} {
      allow read, create, delete: if isResourceOwner();
      allow update: if isResourceOwner() 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance']));
    }
    
    match /packages/{packageId} {
      allow read, write: if isResourceOwner();
    }
    
    match /transactions/{transactionId} {
      allow read, write: if isResourceOwner();
    }

    match /notifications/{notifId} {
      allow read, write: if isResourceOwner();
    }

    match /internal_reviews/{revId} {
      allow create: if true; // Allowed from public portal
      allow read, write: if isResourceOwner();
    }

    match /metrics/{metricId} {
      allow read: if isResourceOwner();
      allow write: if false; // Only Cloud Functions
    }

    match /subdomain_registry/{subdomain} {
      allow read: if request.auth != null;
      allow write: if false; 
    }
  }
}